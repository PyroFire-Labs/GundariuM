{
  "schema": "dreamnet.dreamloop.v1",
  "loop_id": "rosco-session-start-v1",
  "title": "Rosco Session Start",
  "version": "1.0.0",
  "status": "draft",
  "owner": "rosco-gundarium-session-v1",
  "stewards": ["josh"],
  "permission_tier": "read_only",
  "trigger": "manual start of a Rosco GundariuM session",
  "inputs": ["optional approved task identifier"],
  "context_sources": [".rosco/README.md", ".rosco/LOOP.md", ".rosco/STATE.md", ".rosco/TASKS.md"],
  "allowed_actions": [
    "context.local.read",
    "task.local.read",
    "repository.status.read",
    "repository.head.read",
    "receipt.local.write"
  ],
  "blocked_actions": [
    "cloud.mutate",
    "contract.write",
    "deployment.production.write",
    "package.install",
    "public.publish",
    "secret.value.read",
    "self.modify.live",
    "signer.change",
    "wallet.sign"
  ],
  "checks": [],
  "evidence_outputs": ["local Rosco session context", "Git status", "Git revision"],
  "receipt_outputs": ["local Rosco session receipt"],
  "knowledge_state_outputs": ["session-start context summary"],
  "execution_trace_outputs": ["bounded local execution trace"],
  "memory_routes": ["local Rosco runtime state only"],
  "cooldown": "manual invocation only",
  "failure_modes": ["missing Rosco context", "Git unavailable", "invalid Capsule or loop"],
  "promotion_path": "draft -> rehearsed -> active_local",
  "last_reviewed": "2026-11-10",
  "limits": {
    "max_wall_time_ms": 60000,
    "max_steps": 10,
    "max_retries_per_step": 1
  },
  "steps": [
    {
      "id": "load-context",
      "handler": "context.local.read",
      "permission": "context.local.read",
      "with": {}
    },
    {
      "id": "read-task-board",
      "handler": "task.local.read",
      "permission": "task.local.read",
      "with": {}
    },
    {
      "id": "capture-git-status",
      "handler": "repository.status.read",
      "permission": "repository.status.read",
      "with": {}
    },
    {
      "id": "capture-git-head",
      "handler": "repository.head.read",
      "permission": "repository.head.read",
      "with": {}
    },
    {
      "id": "write-receipt",
      "handler": "receipt.local.write",
      "permission": "receipt.local.write",
      "with": {}
    }
  ]
}
