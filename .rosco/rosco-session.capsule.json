{
  "schema": "dreamnet.synergy_capsule.v1",
  "capsule_id": "rosco-gundarium-session-v1",
  "name": "Rosco GundariuM Session",
  "version": "1.0.0",
  "capsule_type": "runtime_profile",
  "status": "draft",
  "purpose": "Read local GundariuM Rosco context, inspect repository state, and create local session receipts. It has no external or production authority.",
  "payload": {
    "agent": "rosco",
    "project": "gundarium",
    "mode": "manual_session_only"
  },
  "permissions": {
    "allowed": [
      "context.local.read",
      "task.local.read",
      "repository.status.read",
      "repository.head.read",
      "receipt.local.write"
    ],
    "blocked": [
      "cloud.mutate",
      "contract.write",
      "deployment.production.write",
      "package.install",
      "public.publish",
      "secret.value.read",
      "self.modify.live",
      "signer.change",
      "wallet.sign"
    ]
  },
  "resource_limits": {
    "max_wall_time_ms": 60000,
    "max_steps": 10,
    "max_retries_per_step": 1
  },
  "activation": {
    "mode": "manual_review",
    "rollback_version": "disabled"
  },
  "provenance": {
    "content_hash": "sha256:916e835459b0c1d786b3166a9924a6829b3ed50de4ebb572f5b6f969317219c0"
  }
}
