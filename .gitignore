# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/worker/node_modules
/worker/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated merkle proofs
scripts/whitelist-proofs.json
scripts/migration-proofs.json

# claude code superpowers plugin metadata
.superpowers/

# dev/test image artifacts (logo iterations + kitbash test renders)
# canonical logo lives at scripts/gndm-token-logoFINAL.png
scripts/gndm-token-logo-[0-9]*.png
scripts/kitbash-[0-9]*.png

# claude code session / conversation exports — raw conversation logs may contain
# pasted secrets; NEVER commit these to a public repo
claudeContext.md
contextFromYesterday*.MD
contextFromYesterday*.md
context*.MD
context*.md
contextcompacted.MD
READ THIS LARRY.MD

# one-off analysis outputs (Farcaster resolution, whitelist diffs, etc.)
scripts/recheck-result.json
scripts/whitelist-missing-addresses.md

# vip-watch local run state — who's already been added to the Guild Chat
scripts/vip-watch/.seen.json

# Claude Code worktrees and local-only settings — never commit a worktree's
# own checkout (nested .git pointer, build artifacts) as regular tracked files
.claude/worktrees/
.claude/settings.local.json

# Warper Keeper exports — self-declared "privacyClassification": "private"
gundariumWarpKeeper.json
gundariumwarptrapper.json
*.trapper.json
*.keeper.json
*.receipt.json
*.proofdrop.json
*.capsule.json
__pycache__/
*.pyc
